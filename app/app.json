{
  "expo": {
    "name": "Adaptle",
    "slug": "adaptle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adaptle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.provenri.adaptle",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.provenri.adaptle",
      "adaptiveIcon": {
        "backgroundColor": "#143326",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47c04264-f61b-4596-9e16-fd5abfadf741"
      }
    },
    "owner": "provenri"
  }
}
