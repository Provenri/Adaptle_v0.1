# Copy to app/.env and fill in from your Supabase project:
# Dashboard -> Project Settings -> API (or `npx supabase status` for local dev).
# EXPO_PUBLIC_* variables are embedded in the client bundle — never put
# service-role keys or other secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
