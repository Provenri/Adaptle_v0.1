# Copy to app/.env and fill in from your Supabase project:
# Dashboard -> Project Settings -> API (or `npx supabase status` for local dev).
# EXPO_PUBLIC_* variables are embedded in the client bundle — never put
# service-role keys or other secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public operator details embedded in Adaptle's client and web bundles.
# Configure the operator name and postal address before publishing /impressum.
EXPO_PUBLIC_IMPRESSUM_OPERATOR_NAME=
EXPO_PUBLIC_IMPRESSUM_POSTAL_ADDRESS=
EXPO_PUBLIC_IMPRESSUM_EMAIL=adaptle.app@gmail.com
# Optional additional direct contact (phone, availability, or similar).
EXPO_PUBLIC_IMPRESSUM_DIRECT_CONTACT=
# Optional where applicable to the operator; leave blank otherwise.
EXPO_PUBLIC_IMPRESSUM_ENTITY_DETAILS=
EXPO_PUBLIC_IMPRESSUM_RESPONSIBLE_PERSON=
