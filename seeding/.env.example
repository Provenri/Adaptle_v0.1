# Copy to seeding/.env and fill in. Never commit the real .env.

# TMDB API: https://www.themoviedb.org/settings/api
# Either a v3 API key or a v4 Read Access Token (starts with "eyJ") works.
TMDB_API_KEY=

# Optional Google Books quota key; used only by the Supabase book-search proxy.
GOOGLE_BOOKS_API_KEY=

# OpenAI API key for one-time hint/thread generation.
OPENAI_API_KEY=
# Optional: override the model (default: gpt-5-mini).
# OPENAI_MODEL=gpt-5-mini

# Supabase (used by the final upload step):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
